(* =========================================================================
   ПРОЕКТ    : Весовой дозатор сахара в мешки 25/50 кг («Ливны»)
   ПЛАТФОРМА : ОВЕН СПК107 · CODESYS 3.5.17 · IEC 61131-3 (Structured Text)
   ОБОРУДОВАНИЕ:
     - МВ110-224.1ТД  — модуль ввода сигнала тензодатчика (вес), RS-485
     - МВ110-8Д.4Р    — 8 дискретных входов / 4 релейных выхода, RS-485
   =========================================================================
   ФАЙЛ      : 01_DUT_Types.st
   НАЗНАЧЕНИЕ: Глобальные типы данных (DUT) проекта.
               В CODESYS: "Добавить объект → DUT", язык ST, перенести типы.
   ========================================================================= *)


TYPE E_DoserState :
(* ------------------------------------------------------------------
   Автомат состояний дозатора. Значения с запасом (шаг 10) —
   удобно для отладки и визуализации СПК107.
   ------------------------------------------------------------------ *)
(
    ST_STOP        := 0,     (* ОСТАНОВ: все выходы отключены            *)
    ST_READY       := 10,    (* ГОТОВНОСТЬ: ожидание команды ПУСК        *)
    ST_CLAMPING    := 20,    (* ЗАЖИМ: фиксация мешка, контроль концевика*)
    ST_TARE        := 30,    (* ТАРА: стабилизация и обнуление веса      *)
    ST_FEED_COARSE := 40,    (* ГРУБО: основная (быстрая) подача сахара  *)
    ST_FEED_FINE   := 50,    (* ТОЧНО: доводка малым питателем           *)
    ST_SETTLING    := 60,    (* УСПОКОЕНИЕ: ожидание стабильного веса    *)
    ST_CHECK       := 70,    (* КОНТРОЛЬ: проверка дозы в допуске        *)
    ST_TOPUP       := 75,    (* ДОСЫПКА: устранение недовеса             *)
    ST_UNCLAMP     := 80,    (* СБРОС: разжим, мешок уходит              *)
    ST_PAUSE       := 90,    (* ПАУЗА: технологическая пауза цикла       *)
    ST_ALARM       := 999    (* АВАРИЯ: требуется вмешательство          *)
);
END_TYPE


TYPE ST_DoseParams :
(* ------------------------------------------------------------------
   Технологические параметры дозирования.
   Загружаются с экрана СПК107 (рецепты 25 / 50 кг), сохраняются
   в RETAIN-области по желанию integratora.
   Все массы — в килограммах (кг), времена — TIME.
   ------------------------------------------------------------------ *)
STRUCT
    rSetpoint       : REAL := 25.0;     (* Заданная масса дозы, кг              *)
    rCoarseCutoff   : REAL := 2.5;      (* Остаток до дозы, на котором
                                           отключается ГРУБАЯ подача, кг
                                           (обычно 8…12 % дозы)                 *)
    rInFlightInit   : REAL := 0.150;    (* Начальная оценка «зависания»
                                           продукта в воздухе/шнеке, кг         *)
    rInFlightMin    : REAL := 0.020;    (* Нижняя граница автокоррекции, кг     *)
    rInFlightMax    : REAL := 0.800;    (* Верхняя граница автокоррекции, кг    *)
    rLearnGain      : REAL := 0.30;     (* Коэффициент обучения 0…1
                                           (доля ошибки, вносимая в коррекцию)  *)
    xLearnEnable    : BOOL := TRUE;     (* Разрешение адаптации «на лету»       *)
    rTolerancePlus  : REAL := 0.050;    (* Допуск «+» на дозу, кг (0,2 % —
                                           жёстче ГОСТ 8.579-2002)              *)
    rToleranceMinus : REAL := 0.050;    (* Допуск «–» на дозу, кг               *)
    rStabBand       : REAL := 0.030;    (* Полоса стабильности весов, кг        *)
    tStabTime       : TIME := T#1S;     (* Время удержания в полосе
                                           стабильности, с                      *)
    tSettle         : TIME := T#1500MS; (* Успокоение после закрытия питателя   *)
    tClampTimeout   : TIME := T#3S;     (* Контроль времени закрытия зажима     *)
    tTareTimeout    : TIME := T#8S;     (* Контроль времени тарирования         *)
    tFlowCheck      : TIME := T#2500MS; (* Окно контроля наличия потока         *)
    rFlowMinStep    : REAL := 0.250;    (* Мин. прирост веса за окно
                                           tFlowCheck на грубой подаче, кг      *)
    rFineFlowMin    : REAL := 0.050;    (* То же для точной подачи, кг          *)
    rTareMax        : REAL := 0.500;    (* Макс. вес пустого мешка (тары), кг   *)
    rTareMin        : REAL := 0.010;    (* Мин. вес пустого мешка (тары), кг    *)
    iTopupMax       : INT  := 3;        (* Макс. число попыток досыпки          *)
    tTopupMax       : TIME := T#2S;     (* Макс. длительность одной досыпки     *)
    tRelease        : TIME := T#800MS;  (* Время разжима (мешок падает)         *)
    tPause          : TIME := T#1S;     (* Пауза перед следующим циклом         *)
    rSetpointMin    : REAL := 5.0;      (* Предел уставки (защита ввода), кг    *)
    rSetpointMax    : REAL := 50.0;     (* Предел уставки (защита ввода), кг    *)
END_STRUCT
END_TYPE


TYPE ST_DoseStats :
(* ------------------------------------------------------------------
   Смена/статистика. Сбрасывается с экрана оператора.
   ------------------------------------------------------------------ *)
STRUCT
    diCount    : DINT := 0;     (* Количество отвешенных доз              *)
    rTotalNet  : REAL := 0.0;   (* Суммарный вес нетто, кг                *)
    rLastNet   : REAL := 0.0;   (* Последняя отвешенная доза, кг          *)
    rLastError : REAL := 0.0;   (* Последняя ошибка (факт − задание), кг  *)
    rSumError  : REAL := 0.0;   (* Сумма ошибок (для среднего), кг        *)
    rMinNet    : REAL := 0.0;   (* Минимальная доза за смену, кг          *)
    rMaxNet    : REAL := 0.0;   (* Максимальная доза за смену, кг         *)
    diUnder    : DINT := 0;     (* Число аварийных недовесов              *)
    diOver     : DINT := 0;     (* Число аварийных передозов              *)
    diTopups   : DINT := 0;     (* Число выполненных досыпок              *)
END_STRUCT
END_TYPE


TYPE ST_Alarms :
(* ------------------------------------------------------------------
   Журнал аварий. Событийные аварии — с самоблокировкой (сброс
   только квитированием), непрерывные условия — «живые».
   ------------------------------------------------------------------ *)
STRUCT
    xEStop      : BOOL;   (* Аварийный останов (грибок/реле безопасности)*)
    xCommLoss   : BOOL;   (* Потеря связи с МВ110-224.1ТД                *)
    xTareFault  : BOOL;   (* Сбой тарирования (нестабильно/тяжёлый мешок)*)
    xNoFlow     : BOOL;   (* Нет потока продукта: затор шнека, пусто     *)
    xOverdose   : BOOL;   (* Передоз сверх допуска (ручная выгрузка)     *)
    xUnderdose  : BOOL;   (* Недовес сверх допуска после досыпок         *)
    xClampFault : BOOL;   (* Зажим не закрылся за отведённое время       *)
    xAirLow     : BOOL;   (* Низкое давление пневмосети («живое»)        *)
    xLevelLow   : BOOL;   (* Нет продукта в расходном бункере («живое»)  *)
    xCoverOpen  : BOOL;   (* Открыта защитная крышка («живое»)           *)
    xActive     : BOOL;   (* Есть хотя бы одна активная авария           *)
END_STRUCT
END_TYPE


TYPE ST_WeightData :
(* ------------------------------------------------------------------
   Обработанные данные весового канала (после FB_WeightChannel).
   ------------------------------------------------------------------ *)
STRUCT
    rNet      : REAL;    (* Вес нетто: фильтр − тара, кг                 *)
    rGross    : REAL;    (* Вес брутто (отфильтрованный), кг             *)
    rTare     : REAL;    (* Текущая тара, кг                             *)
    xStable   : BOOL;    (* Вес стабилен (полоса + время)                *)
    rFlowRate : REAL;    (* Скорость потока продукта, кг/мин             *)
    xCommOK   : BOOL;    (* Связь с тензомодулем в норме                 *)
END_STRUCT
END_TYPE


TYPE ST_ManualMode :
(* ------------------------------------------------------------------
   Ручной режим (пусконаладка): прямое управление выходами с экрана.
   ------------------------------------------------------------------ *)
STRUCT
    xClamp   : BOOL;     (* Зажим мешка                                  *)
    xCoarse  : BOOL;     (* Грубый питатель                              *)
    xFine    : BOOL;     (* Точный питатель                              *)
    xSignal  : BOOL;     (* Сигнальная лампа/зуммер                      *)
    xTare    : BOOL;     (* Тарирование весов                            *)
END_STRUCT
END_TYPE


TYPE ST_HmiDisplay :
(* ------------------------------------------------------------------
   Поля для экрана СПК107 (визуализация). Заполняются в PRG_HMI,
   объекты HMI привязываются к g_Hmi.*
   ------------------------------------------------------------------ *)
STRUCT
    rNet       : REAL;   (* Текущий вес нетто, кг                        *)
    rSetpoint  : REAL;   (* Уставка дозы, кг                             *)
    rLastError : REAL;   (* Ошибка последней дозы, кг                    *)
    rInFlight  : REAL;   (* Текущая автокоррекция «на лету», кг          *)
    rFlowRate  : REAL;   (* Скорость потока, кг/мин                      *)
    diCount    : DINT;   (* Счётчик доз                                  *)
    rLastNet   : REAL;   (* Последняя доза, кг                           *)
    iState     : INT;    (* Номер состояния автомата (для индикации)     *)
    sState     : STRING(16); (* Мнемокод состояния: ГОТОВ, ГРУБО…        *)
    xStable    : BOOL;   (* Индикатор стабильности                       *)
    xCommOK    : BOOL;   (* Индикатор связи с весами                     *)
    xManual    : BOOL;   (* Признак ручного режима                       *)
END_STRUCT
END_TYPE

