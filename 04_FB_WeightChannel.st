(* =========================================================================
   ПРОЕКТ    : Весовой дозатор сахара в мешки 25/50 кг («Ливны»)
   ПЛАТФОРМА : ОВЕН СПК107 · CODESYS 3.5.17 · IEC 61131-3 (Structured Text)
   =========================================================================
   ФАЙЛ      : 04_FB_WeightChannel.st
   НАЗНАЧЕНИЕ: Первичная обработка весового сигнала МВ110-224.1ТД:
                 - контроль связи (watchdog достоверности);
                 - экспоненциальный фильтр (подавление вибраций шнека);
                 - контроль стабильности (полоса + выдержка);
                 - тарирование (смещение нуля + импульс в модуль);
                 - оценка скорости потока (кг/мин) для диагностики затора.

               Примечание: модуль МВ110-224.1ТД имеет собственный
               цифровой фильтр (настраивается в Owen Configurator),
               программный фильтр здесь — второй каскад.
   ========================================================================= *)

FUNCTION_BLOCK FB_WeightChannel

VAR_INPUT
    rWeightRaw  : REAL;     (* «сырой» вес от ФБ-шаблона модуля, кг       *)
    xValid      : BOOL;     (* данные достоверны (опрос без ошибок)       *)
    xError      : BOOL;     (* аппаратная ошибка модуля/датчика           *)
    xTareCmd    : BOOL;     (* запрос тарирования (импульс от автомата)   *)
    xTareManual : BOOL;     (* ручное тарирование с экрана                *)
    rStabBand   : REAL;     (* полоса стабильности, кг                    *)
    tStabTime   : TIME;     (* выдержка в полосе стабильности             *)
    rTaskCycle  : REAL := 0.02; (* цикл задачи ПЛК, с (см. конфигурацию
                                   задачи СПК107, обычно 10…20 мс)        *)
END_VAR

VAR_OUTPUT
    rNet       : REAL;      (* вес нетто (фильтр − тара), кг              *)
    rGross     : REAL;      (* вес брутто (фильтр), кг                    *)
    rTare      : REAL;      (* текущая тара, кг                           *)
    xStable    : BOOL;      (* вес стабилен                               *)
    rFlowRate  : REAL;      (* скорость потока, кг/мин                    *)
    xCommOK    : BOOL;      (* связь с весовым модулем в норме            *)
    xTarePulse : BOOL;      (* импульс «установить ноль» в ФБ модуля      *)
    xTared     : BOOL;      (* тара успешно установлена                   *)
END_VAR

VAR
    rFlt       : REAL;      (* выход ЭМА-фильтра                          *)
    rPrev      : REAL;      (* значение нетто в предыдущем скане          *)
    rDiffEma   : REAL;      (* ЭМА приращения за скан                     *)
    rStabRef   : REAL;      (* опорное значение для полосы стабильности   *)
    rTareOfs   : REAL;      (* смещение тары, кг                          *)
    rK         : REAL := 0.25;   (* коэффициент ЭМА (0…1; меньше — глубже)*)
    rKFlow     : REAL := 0.10;   (* сглаживание оценки скорости           *)
    tonComm    : TON;       (* watchdog связи                             *)
    tonStab    : TON;       (* выдержка стабильности                      *)
    rtTare     : R_TRIG;    (* фронт запроса тарирования                  *)
    tpTare     : TP;        (* импульс команды в модуль                   *)
    xInitDone  : BOOL;      (* флаг первого скана                         *)
END_VAR

(* ---------------------------------------------------------------------
   0. Первый скан: инициализируем фильтр текущим значением,
      чтобы не «догонять» его от нуля.
   --------------------------------------------------------------------- *)
IF NOT xInitDone THEN
    rFlt      := rWeightRaw;
    rPrev     := rWeightRaw;
    rStabRef  := rWeightRaw;
    xInitDone := TRUE;
END_IF

(* ---------------------------------------------------------------------
   1. WATCHDOG СВЯЗИ. Если модуль не отвечает или сообщает ошибку
      дольше 3 с — весовым данным доверять нельзя: автомат дозирования
      будет переведён в аварию (см. FB_DoserControl).
   --------------------------------------------------------------------- *)
tonComm(IN := xValid AND NOT xError, PT := T#3S);
xCommOK := tonComm.Q;

(* ---------------------------------------------------------------------
   2. ЭКСПОНЕНЦИАЛЬНЫЙ ФИЛЬТР:  y[k] = y[k-1] + K·(x[k] − y[k-1])
      При K = 0.25 и цикле 20 мс постоянная времени ≈ 60 мс:
      вибрации от шнека гасятся, фронт насыпки почти не запаздывает.
   --------------------------------------------------------------------- *)
IF xCommOK THEN
    rFlt := rFlt + rK * (rWeightRaw - rFlt);
END_IF

rGross := rFlt;
rNet   := rFlt - rTareOfs;

(* ---------------------------------------------------------------------
   3. СКОРОСТЬ ПОТОКА (кг/мин).
      Приращение за скан усредняется и пересчитывается в минуту.
      Используется автоматом для ранней диагностики «нет потока».
   --------------------------------------------------------------------- *)
IF xCommOK THEN
    rDiffEma := rDiffEma + rKFlow * ((rNet - rPrev) - rDiffEma);
    rPrev    := rNet;
    IF rTaskCycle > 0.001 THEN
        rFlowRate := 60.0 * rDiffEma / rTaskCycle;
    ELSE
        rFlowRate := 0.0;                 (* защита от деления на 0 *)
    END_IF
ELSE
    rFlowRate := 0.0;
END_IF

(* ---------------------------------------------------------------------
   4. КОНТРОЛЬ СТАБИЛЬНОСТИ. Вес считается стабильным, если
      tStabTime подряд не выходит из полосы ±rStabBand вокруг
      опорного значения. Опора обновляется при каждом «выбеге».
   --------------------------------------------------------------------- *)
IF ABS(rNet - rStabRef) > rStabBand THEN
    rStabRef := rNet;
END_IF;

tonStab(IN := (ABS(rNet - rStabRef) <= rStabBand) AND xCommOK,
        PT := tStabTime);
xStable := tonStab.Q;

(* ---------------------------------------------------------------------
   5. ТАРИРОВАНИЕ. Выполняется только на стабильном весе:
      запоминаем брутто как смещение тары и выдаём импульс
      «установить ноль» в ФБ-шаблон модуля (g_xTareToModule),
      чтобы аппаратный и программный нули совпадали.
   --------------------------------------------------------------------- *)
rtTare(CLK := xTareCmd OR xTareManual);

IF rtTare.Q THEN
    IF xStable AND xCommOK THEN
        rTareOfs := rFlt;            (* программная тара            *)
        xTared   := TRUE;
        tpTare(IN := TRUE, PT := T#500MS);   (* импульс в модуль    *)
    ELSE
        xTared := FALSE;             (* условия не выполнены        *)
    END_IF
ELSE
    tpTare(IN := FALSE);
END_IF;

xTarePulse := tpTare.Q;
rTare      := rTareOfs;

(* При потере связи «замораживаем» признак стабильности —
   дозировать на неверных данных запрещено.                          *)
IF NOT xCommOK THEN
    xStable := FALSE;
END_IF

END_FUNCTION_BLOCK

(* =========================================================================
   КОНЕЦ ФАЙЛА 04_FB_WeightChannel.st
   ========================================================================= *)
