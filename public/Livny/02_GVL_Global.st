(* =========================================================================
   ПРОЕКТ    : Весовой дозатор сахара в мешки 25/50 кг («Ливны»)
   ПЛАТФОРМА : ОВЕН СПК107 · CODESYS 3.5.17 · IEC 61131-3 (Structured Text)
   =========================================================================
   ФАЙЛ      : 02_GVL_Global.st
   НАЗНАЧЕНИЕ: Глобальный список переменных (GVL).
               В CODESYS: "Добавить объект → Список глобальных переменных",
               язык "GVL в ST", перенести объявления.

   ВАЖНО: переменные НЕ привязаны к физическим входам/выходам (%I/%Q).
          Связка выполняется интегратором в CODESYS:
            g_rWeightRaw    <- выход веса шаблона МВ110-224.1ТД (МХ110)
            g_xDi*          <- дискретные входы шаблона МВ110-8Д.4Р
            g_xDo*          -> релейные выходы шаблона МВ110-8Д.4Р
   ========================================================================= *)

VAR_GLOBAL

    (* ─────────────────────────────────────────────────────────────────
       ВЕСОВОЙ КАНАЛ — МВ110-224.1ТД (адрес в сети RS-485, напр. 16)
       Подключаются к выходам ФБ-шаблона тензомодуля (библиотека
       шаблонов МХ110 / OwenVendorProtocols).
       ───────────────────────────────────────────────────────────────── *)
    g_rWeightRaw     : REAL;      (* Текущий вес от модуля, кг            *)
    g_xWeightValid   : BOOL;      (* Данные достоверны (опрос без ошибок) *)
    g_xWeightErr     : BOOL;      (* Аппаратная ошибка тензомодуля        *)
    g_xTareToModule  : BOOL;      (* Команда «установить ноль» в модуль
                                     (вход Тара/Zero ФБ-шаблона)          *)

    (* ─────────────────────────────────────────────────────────────────
       ДИСКРЕТНЫЕ ВХОДЫ — МВ110-8Д.4Р (адрес в сети RS-485, напр. 17)
       «Сырые» значения каналов DI0…DI7 до антидребезга.
       ───────────────────────────────────────────────────────────────── *)
    g_xDiStart        : BOOL;     (* DI0: кнопка ПУСК (НО, с фиксацией)   *)
    g_xDiStop         : BOOL;     (* DI1: кнопка СТОП (НО)                *)
    g_xDiEStop        : BOOL;     (* DI2: аварийный стоп — НЗ-контакт
                                     (обрыв цепи = авария)                *)
    g_xDiBagPresent   : BOOL;     (* DI3: датчик «мешок в зоне загрузки»  *)
    g_xDiClampClosed  : BOOL;     (* DI4: концевик «зажим закрыт»         *)
    g_xDiAirOK        : BOOL;     (* DI5: реле давления пневмосети ≥ 4 бар*)
    g_xDiLevelOK      : BOOL;     (* DI6: уровень сахара в бункере выше
                                     минимума                             *)
    g_xDiCoverClosed  : BOOL;     (* DI7: защитная крышка закрыта         *)

    (* ─────────────────────────────────────────────────────────────────
       ДИСКРЕТНЫЕ ВЫХОДЫ — реле R0…R3 модуля МВ110-8Д.4Р
       ───────────────────────────────────────────────────────────────── *)
    g_xDoClamp   : BOOL;          (* R0: пневмоклапан зажима мешка        *)
    g_xDoCoarse  : BOOL;          (* R1: грубый питатель (основной шнек)  *)
    g_xDoFine    : BOOL;          (* R2: точный питатель (малый шнек)     *)
    g_xDoSignal  : BOOL;          (* R3: сигнальная лампа / зуммер        *)

    (* ─────────────────────────────────────────────────────────────────
       КОМАНДЫ С ЭКРАНА СПК107 (объекты визуализации пишут сюда)
       ───────────────────────────────────────────────────────────────── *)
    g_xHmiStart    : BOOL;        (* Экранная кнопка ПУСК                 *)
    g_xHmiStop     : BOOL;        (* Экранная кнопка СТОП                 *)
    g_xHmiAck      : BOOL;        (* Квитирование аварий                  *)
    g_xHmiResetStat: BOOL;        (* Сброс статистики смены               *)
    g_xHmiTare     : BOOL;        (* Ручное тарирование                   *)
    g_xHmiRecipe25 : BOOL;        (* Быстрый выбор рецепта 25 кг          *)
    g_xHmiRecipe50 : BOOL;        (* Быстрый выбор рецепта 50 кг          *)
    g_rHmiSetpoint : REAL := 25.0;(* Поле ввода уставки с экрана, кг      *)
    g_xManualMode  : BOOL;        (* Переключатель АВТО / РУЧНОЙ          *)
    g_Manual       : ST_ManualMode; (* Кнопки ручного режима              *)

    (* ─────────────────────────────────────────────────────────────────
       ПРОЦЕССНЫЕ ДАННЫЕ (общие для логики, HMI и архива)
       ───────────────────────────────────────────────────────────────── *)
    g_Params : ST_DoseParams;     (* Технологические параметры            *)
    g_Stats  : ST_DoseStats;      (* Статистика смены                     *)
    g_Alarms : ST_Alarms;         (* Состояние аварий                     *)
    g_Weight : ST_WeightData;     (* Обработанный весовой канал           *)
    g_Hmi    : ST_HmiDisplay;     (* Данные для экрана                    *)
    g_eState : E_DoserState := ST_STOP; (* Текущее состояние автомата     *)

END_VAR

(* =========================================================================
   КОНЕЦ ФАЙЛА 02_GVL_Global.st
   ========================================================================= *)
